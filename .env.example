# Copy to .env.local and fill values. Never commit credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# At least 32 characters; generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Tenant ID explicitly selected for public landing pages.
PUBLIC_TENANT_ID=
PAYMENT_PROVIDER=midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
# Server-only demo mode; ignored when NODE_ENV=production.
DEMO_MODE=false
# Optional ESC/POS network printer, reachable from the Next.js server.
PRINTER_PROTOCOL=escpos
PRINTER_HOST=
PRINTER_PORT=9100
PRINTER_WIDTH_DOTS=576
# Optional WhatsApp provider.
FONNTE_API_TOKEN=
WABLAS_API_TOKEN=
WANOTIF_API_TOKEN=
WHATSAPP_SENDER_NUMBER=
